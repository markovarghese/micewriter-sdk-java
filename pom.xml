<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot starter-parent is used at the root so its BOM manages
        common library versions (Netty, Jackson, JUnit) across all modules.
        Spring classes are only pulled onto the classpath in micewriter-sdk-java-spring.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>

    <groupId>com.micewriter</groupId>
    <artifactId>micewriter-sdk-java</artifactId>
    <version>0.2.0</version>
    <packaging>pom</packaging>
    <description>mIceWriter SDK — multi-module parent (core / Spring Boot starter / Dropwizard bundle)</description>

    <modules>
        <module>micewriter-sdk-java-core</module>
        <module>micewriter-sdk-java-spring</module>
        <module>micewriter-sdk-java-dropwizard</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <arrow.version>17.0.0</arrow.version>
        <dropwizard.version>4.0.7</dropwizard.version>
    </properties>

    <!-- Centralise versions for libraries not covered by the Spring Boot BOM -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.apache.arrow</groupId>
                <artifactId>arrow-vector</artifactId>
                <version>${arrow.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.arrow</groupId>
                <artifactId>arrow-memory-netty</artifactId>
                <version>${arrow.version}</version>
            </dependency>
            <dependency>
                <groupId>io.dropwizard</groupId>
                <artifactId>dropwizard-core</artifactId>
                <version>${dropwizard.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
